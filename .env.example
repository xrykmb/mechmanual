# Copy to .env and fill in when generation / embeddings are wired.
# DeepSeek chat (https://platform.deepseek.com/)
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Embeddings: DeepSeek has no embed API. Use OpenAI-compatible /embeddings.
# LLM_EMBED_API_KEY=
# LLM_EMBED_BASE_URL=https://api.siliconflow.cn/v1
# LLM_EMBED_MODEL=BAAI/bge-m3
